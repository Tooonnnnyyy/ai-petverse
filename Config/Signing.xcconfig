// Shared signing settings for the app and test targets.
// Put your Apple Developer team ID in Config/Signing.local.xcconfig (ignored by Git),
// using Config/Signing.local.xcconfig.example as the template. Avoid setting the team
// in Xcode's Signing & Capabilities tab: that writes the ID into the public project file.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
